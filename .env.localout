VITE_API_BASE_URL=/api
VITE_AUTH_API_BASE_URL=http://100.66.39.64:8088/api/ca/auth
VITE_CA_API_BASE_URL=http://100.66.39.64:8089/api/ca
VITE_CDM_API_BASE_URL=http://100.66.39.64:8090/api/cm
VITE_BO_API_BASE_URL=http://100.66.39.64:8091/api/bo
VITE_ADVICE_API_BASE_URL=http://100.66.39.64:8088/api/uex
VITE_THUMBNAIL_API_BASE_URL=/api

VITE_APP_BASE=http://100.66.39.64:8080/
