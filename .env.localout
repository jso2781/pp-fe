# (선택) Any-ID esign `/api/pp/auth/esign/*` → 스테이징 (미설정 시 일반 `/api` 프록시)
PROXY_PP_ESIGN_TARGET=https://stg.drugsafe.or.kr

# true일 때 개발모드에서도 Any-ID 인증영역을 보여준다.
VITE_SHOW_ANYID_AREA=true